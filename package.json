{
	"name": "theeditor",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "TheEditor! A typographic Markdown editor for journals, books and comics.",
	"scripts": {
		"dev": "hutch run dev",
		"start": "hutch run start",
		"build": "hutch run build:stable",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@milkdown/kit": "7.22.3",
		"@milkdown/plugin-highlight": "^7.22.3",
		"dompurify": "^3.4.17",
		"fast-png": "8.0.0",
		"lowlight": "^3.3.0",
		"remark-frontmatter": "^5.0.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "21.0.3",
		"@milkdown/crepe": "7.22.3",
		"@types/bun": "^1.3.14",
		"electrobun": "^2.0.2",
		"happy-dom": "21.0.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	},
	"prettier": {
		"arrowParens": "avoid",
		"printWidth": 120,
		"singleQuote": true,
		"tabWidth": 2,
		"trailingComma": "es5"
	}
}
